{
  "name": "private-stream/backend",
  "type": "project",
  "require": {
    "php": ">=8.3",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test:feature": "vendor/bin/phpunit --testsuite=Feature",
    "lint": "vendor/bin/php-cs-fixer fix --dry-run --diff",
    "fix": "vendor/bin/php-cs-fixer fix",
    "migrate": "php scripts/migrate.php",
    "seed": "php scripts/seed.php"
  }
}

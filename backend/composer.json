{
  "name": "private-stream/backend",
  "type": "project",
  "require": {
    "php": ">=8.3",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --testdox",
    "migrate": "php scripts/migrate.php",
    "seed": "php scripts/seed.php"
  }
}
